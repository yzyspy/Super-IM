type Response {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data string `json:"data"`
}

type ImageRequest {}

type ImageResponsse {
	Url string `json:"url"` //图片地址
}

type ImageShowRequest {
	ImageType string `path:"imageType"` //图片类型, 这个这个地方是path ！！！！！！！！，不是json
	ImageName string `path:"imageName"` //图片名称
}

type ImageShowResponse {}

service file {
	@handler Image
	post /api/file/image (ImageRequest) returns (ImageResponsse) //图片上传

	@handler ImageShow
	get /api/file/uploads/:imageType/:imageName (ImageShowRequest)
}

