type Response {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data string `json:"data"`
}

type UserInfoRequest {
	UserID uint `header:"uid"`
	Role   int8 `header:"role"`
}

type UserSearchRequest {
	UserID   uint   `form:"uid"`
	Nickname string `form:"nickname"`
}

type UserInfoData {
	UserID       uint   `json:"uid"`
	Nickname     string `json:"nickname"`
	Avatar       string `json:"avatar"`
	Role         int8   `json:"role"`
	Abstract     string `json:"abstract"`
	Verification int    `json:"verification"`
}

type UserInfoResponse {
	Code int          `json:"code"`
	Msg  string       `json:"msg"`
	Data UserInfoData `json:"data"`
}

type UserInfoUpdateResponse {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data bool   `json:"data"`
}

type UserInfoUpdateRequest {
	Nickname string `json:"nickname,optional"`
	Avatar   string `json:"avatar,optional"`
	Abstract string `json:"abstract,optional"`
}

type FriendInfoRequest {
	UserID uint `header:"uid"`
	Role   int8 `header:"role"` //这个地方支持 header、path、form
}

type FriendInfoResponse {
	Code int          `json:"code"`
	Msg  string       `json:"msg"`
	Data UserInfoData `json:"data"`
}

type FriendListRequest {
	UserID uint `header:"uid"`
	Role   int8 `header:"role"`
	Page   int  `form:"page,optional"`
	Limit  int  `form:"limit,optional"`
}

type FriendListResponse {
	List  []UserInfoData `json:"list"`
	Count int            `json:"count"`
}

type UserListResponse {
	List  []UserInfoData `json:"list"`
	Count int            `json:"count"`
}

type ApplyFriendRequest {
	UserID uint `json:"uid"` //添加好友的用户id
}

type ApplyFriendResponse {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data bool   `json:"data"`
}

type FriendApplyListRequest {}

type FriendApplyListResponse {
	Code int            `json:"code"`
	Msg  string         `json:"msg"`
	List []UserInfoData `json:"list"`
}

type ResponseFriendApplyRequest {
	Friend_verify_id int  `json:"code"`
	Status           int8 `json:"status"` // 1:同意 2:拒绝
}

type ResponseFriendApplyResponse {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data bool   `json:"data"`
}

type FriendDeleteRequest {
	UserID uint `json:"uid"`
}

type FriendDeleteResponse {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data bool   `json:"data"`
}

service users {
	// 查询当前登录用户信息
	@handler UserInfo
	get /api/user/user_info (UserInfoRequest) returns (UserInfoResponse)

	// 更新当前登录用户信息
	@handler UpdateUserInfo
	post /api/user/update_user_info (UserInfoUpdateRequest) returns (UserInfoUpdateResponse)

	// 查询用户某一个好友的信息
	@handler FriendInfo
	get /api/user/friend_info (FriendInfoRequest) returns (FriendInfoResponse)

	// 查询用户好友列表 (//1.好友列表)
	@handler FriendList
	get /api/user/friend_list (FriendListRequest) returns (FriendListResponse)

	// 用户模糊搜索 (用户昵称或者uid模糊搜索)
	@handler UserSearch
	get /api/user/user_search (UserSearchRequest) returns (UserListResponse)

	// 申请好友
	@handler applyFriend
	post /api/user/apply_friend (ApplyFriendRequest) returns (ApplyFriendResponse) //添加好友申请

	// 当前登录用户,查看被别人加好友的记录
	@handler friendApplyList
	get /api/user/friend_apply_list (FriendApplyListRequest) returns (FriendApplyListResponse) //好友申请列表

	// 同意或者拒绝好友申请
	@handler responseFriendApply
	put /api/user/response_friend_apply (ResponseFriendApplyRequest) returns (ResponseFriendApplyResponse) //同意或者拒绝好友申请

	// 删除好友
	@handler friendDelete
	delete /api/user/friends (FriendDeleteRequest) returns (FriendDeleteResponse)
}

//goctl api go -api user_api.api -dir . --home  ../../my_template/
