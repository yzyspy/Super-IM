type Response {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data string `json:"data"`
}

type UserInfoRequest {
	UserID uint `header:"uid"`
	Role   int8 `header:"role"`
}

type UserSearchRequest {
	UserID   uint   `path:"uid"`
	Nickname string `path:"nickname"`
}

type UserInfoData {
	UserID   uint   `json:"uid"`
	Nickname string `json:"nickname"`
	Avatar   string `json:"avatar"`
	Role     int8   `json:"role"`
	Abstract string `json:"abstract"`
}

type UserInfoResponse {
	Code int          `json:"code"`
	Msg  string       `json:"msg"`
	Data UserInfoData `json:"data"`
}

type UserInfoUpdateResponse {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
	Data bool   `json:"data"`
}

type UserInfoUpdateRequest {
	Nickname string `json:"nickname,optional"`
	Avatar   string `json:"avatar,optional"`
	Abstract string `json:"abstract,optional"`
}

type FriendInfoRequest {
	UserID uint `header:"uid"`
	Role   int8 `header:"role"` //这个地方支持 header、path、form
}

type FriendInfoResponse {
	Code int          `json:"code"`
	Msg  string       `json:"msg"`
	Data UserInfoData `json:"data"`
}

type FriendListRequest {
	UserID uint `header:"uid"`
	Role   int8 `header:"role"`
	Page   int  `form:"page,optional"`
	Limit  int  `form:"limit,optional"`
}

type FriendListResponse {
	List  []UserInfoData `json:"list"`
	Count int            `json:"count"`
}

type UserListResponse {
	List  []UserInfoData `json:"list"`
	Count int            `json:"count"`
}

service users {
	// 查询当前登录用户信息
	@handler UserInfo
	get /api/user/user_info (UserInfoRequest) returns (UserInfoResponse)

	// 更新当前登录用户信息
	@handler UpdateUserInfo
	post /api/user/update_user_info (UserInfoUpdateRequest) returns (UserInfoUpdateResponse)

	// 查询用户某一个好友的信息
	@handler FriendInfo
	get /api/user/friend_info (FriendInfoRequest) returns (FriendInfoResponse)

	// 查询用户好友列表 (//1.好友列表)
	@handler FriendList
	get /api/user/friend_list (FriendListRequest) returns (FriendListResponse)

	// 用户模糊搜索 (用户昵称或者uid模糊搜索)
	@handler UserSearch
	get /api/user/user_search (UserSearchRequest) returns (UserListResponse)
// 申请好友
// 查看被加好友的记录
// 同意或者拒绝好友申请
}

//goctl api go -api user_api.api -dir . --home  ../../my_template/
